{
  // SPA (Workers Static Assets) deploy config — reused from the prior deployment.
  // Production deploy: `wrangler deploy` → jw3b-dev-site (served on jw3b.dev + www).
  // Preview deploy (CI on push to v2): `wrangler deploy --name jw3b-dev-site-v2` overrides
  // ONLY the name → jw3b-dev-site-v2.agilegypsy.workers.dev, production untouched. Same
  // assets/SPA settings either way.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jw3b-dev-site",
  "main": "worker.js",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // run_worker_first: worker.js runs on EVERY request so it can set the security headers +
    // cache rules. Workers Static Assets does NOT honor the _headers file (that was a Pages
    // feature), so the worker must own them — verified: without this, the deployed site ships
    // no CSP and no cache-control (P0-11 / ADR-08 headers were inert).
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
