{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jw3b-dev-site",
  "main": "worker.js",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
