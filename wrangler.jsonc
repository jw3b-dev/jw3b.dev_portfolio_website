{
  // SPA (Workers Static Assets) deploy config.
  //
  // ONE deploy target, and it is production: `wrangler deploy` → jw3b-dev-site, served on
  // jw3b.dev + www. CI runs it explicitly as
  // `wrangler deploy --name jw3b-dev-site --config wrangler.jsonc`, and that workflow is the only
  // path to the live site.
  "$schema": "node_modules/wrangler/config-schema.json",
  // The isolated `-v2` preview instance was deleted 2026-08-21. Naming production HERE is the
  // point: as a preview default, a bare `wrangler deploy` quietly created a second live site.
  "name": "jw3b-dev-site",
  "main": "worker.js",
  "compatibility_date": "2025-05-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // run_worker_first: worker.js runs on EVERY request so it can set the security headers +
    // cache rules. Workers Static Assets does NOT honor the _headers file (that was a Pages
    // feature), so the worker must own them — verified: without this, the deployed site ships
    // no CSP and no cache-control (P0-11 / ADR-08 headers were inert).
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
