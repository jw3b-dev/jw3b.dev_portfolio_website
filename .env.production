# jw3b.dev v2 — production build env (Vite loads this only for `npm run build`, mode=production).
# PUBLIC values only — these are embedded in the client bundle. NO secrets here (Anthropic key,
# Neon URL, etc. are Worker secrets set via `wrangler secret put`, never a VITE_ var).

# WalletConnect project id — a public client identifier (reused from the prior deploy).
# Allowlist jw3b.dev in the WalletConnect Cloud dashboard so it's domain-scoped.
VITE_WALLETCONNECT_PROJECT_ID=7d846054fb59feca2766bad9883062f1

# Feature flags — the deployed posture. ON = wired + provisioned:
#   ctf           — live vault deployed on Base Sepolia (0x4f72…C240)
#   kthulhu/kointel embed — both origins opted jw3b.dev in via CSP frame-ancestors
# OFF (omitted → default false): escrow + unlock stay off until their addresses/locks exist.
VITE_FEATURE_CTF=true
VITE_FEATURE_KTHULHU_EMBED=true
VITE_FEATURE_KOINTEL_EMBED=true
