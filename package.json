{
  "name": "jw3b-dev-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.js",
    "build": "vite build --config config/vite.config.js",
    "preview": "vite preview --config config/vite.config.js",
    "lint": "eslint . --config config/eslint.config.js",
    "test": "vitest run --config config/vitest.config.js",
    "test:watch": "vitest --config config/vitest.config.js",
    "test:coverage": "vitest run --coverage --config config/vitest.config.js",
    "claims-gate": "node scripts/claims-gate.mjs",
    "seed:kv": "node scripts/seed-kv-runs.mjs",
    "gen:knowledge": "node scripts/gen-knowledge.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "e2e": "playwright test",
    "e2e:prod": "E2E_BASE_URL=https://jw3b.dev playwright test",
    "coverage:worker": "vitest run --config config/vitest.config.js workers --coverage --coverage.include='workers/portfolio-agent/src/rateLimit.js' --coverage.include='workers/portfolio-agent/src/tagProtocol.js' --coverage.include='workers/portfolio-agent/src/routes/voice.js' --coverage.include='workers/portfolio-agent/src/routes/ctf.js' --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.branches=85 --coverage.thresholds.statements=90"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.90.17",
    "@xmtp/browser-sdk": "^7.1.0",
    "buffer": "^6.0.3",
    "framer-motion": "^12.23.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.12.0",
    "viem": "^2.55.0",
    "vite-plugin-node-polyfills": "^0.2.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.25.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.0"
