# dependencies
node_modules/

# build / test output
dist/
coverage/

# wrangler local dev state (miniflare cache, local KV/D1/R2) — never commit
.wrangler/

# env — only public VITE_* values belong in .env; secrets are Worker-only
.env
.env.local
.env.*.local

# Telegram bot token, staged here only long enough for `npm run telegram:setup` to pipe it into
# `wrangler secret put`. Delete it after. A token in git history is compromised, not just leaked.
workers/portfolio-agent/.telegram

# editor / OS
.DS_Store
*.log

# Playwright
playwright-report/
test-results/
